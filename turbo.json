{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": ["**/.env.*local"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"env": ["VITE_MUSE_VOICE_PRECONNECT"],
			"outputs": ["out/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"type-check": {
			"dependsOn": ["^type-check"]
		}
	}
}
