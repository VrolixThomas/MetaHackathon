{
	"name": "metahackathon-repo",
	"version": "0.1.0",
	"private": true,
	"workspaces": ["apps/*", "packages/*", "tooling/*"],
	"scripts": {
		"postinstall": "bun run --filter @metahackathon/desktop postinstall",
		"dev": "turbo run dev",
		"build": "turbo run build",
		"lint": "biome check .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"type-check": "turbo run type-check",
		"test:contracts": "bun test apps/desktop/src/shared apps/desktop/src/main/trpc/routers",
		"test:integration": "bun run --filter @metahackathon/desktop test:integration",
		"pack": "bun run --filter @metahackathon/desktop pack",
		"dist": "bun run --filter @metahackathon/desktop dist",
		"test:prepared-reviews": "bun run --filter @metahackathon/desktop test:prepared-reviews",
		"test:local-browser": "bun run --filter @metahackathon/desktop test:local-browser",
		"test:hands-free": "bun run --filter @metahackathon/desktop test:hands-free",
		"test:workspace": "bun run --filter @metahackathon/desktop test:workspace",
		"test:executive": "bun run --filter @metahackathon/desktop test:executive",
		"test:attention": "bun run --filter @metahackathon/desktop test:attention",
		"test:oauth": "bun run --filter @metahackathon/desktop test:oauth",
		"test:day": "bun run --filter @metahackathon/desktop test:day",
		"test:slack-oauth": "bun run --filter @metahackathon/desktop test:slack-oauth",
		"test:pr-work": "bun run --filter @metahackathon/desktop test:pr-work",
		"test:pr-fixes": "bun run --filter @metahackathon/desktop test:pr-fixes",
		"test:coding-provider": "bun run --filter @metahackathon/desktop test:coding-provider",
		"team:serve": "bun services/team/entry.ts serve",
		"team:consume": "bun services/team/entry.ts consume",
		"test:team": "bun test services/team apps/desktop/src/main/team",
		"test:team:db": "bash services/team/test-sql.sh",
		"test:comment-conversation": "bun run --filter @metahackathon/desktop test:comment-conversation",
		"test:image-workspace": "bun run --filter @metahackathon/desktop test:image-workspace",
		"test:team-workspace": "bun run --filter @metahackathon/desktop test:team-workspace"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"turbo": "2.8.21",
		"typescript": "5.9.3"
	},
	"packageManager": "bun@1.3.9",
	"engines": {
		"node": ">=22.12.0",
		"bun": ">=1.3.9"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"@metahackathon/desktop",
		"electron",
		"better-sqlite3",
		"esbuild"
	]
}
