# Local sharing API only; never copy the service-role key to desktop.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Shared cache policy identity; match desktop-selected scope. No server model key is required.
TEAM_ANALYSIS_VERSION=muse-local-review-v1
TEAM_HOST=127.0.0.1
TEAM_PORT=8787
# Optional local Supabase development only; permits loopback HTTP, never remote HTTP.
TEAM_ALLOW_LOCAL_SUPABASE=0
