# Server only; never copy service-role or GitHub App secrets to desktop.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_APP_ID=
# PEM; escaped \n is accepted. Use a supervised backend secret store in deployment.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Explicit release identity covering prepareReview prompt, model and context policy.
TEAM_ANALYSIS_VERSION=
# Required only by the hosted preparation consumer.
META_API_KEY=
TEAM_HOST=127.0.0.1
TEAM_PORT=8787
# Optional local Supabase development only; permits loopback HTTP, never remote HTTP.
TEAM_ALLOW_LOCAL_SUPABASE=0
