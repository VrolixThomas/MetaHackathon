{
	"display_information": {
		"name": "Muse",
		"description": "Voice command center for reviews, tasks and follow-ups",
		"background_color": "#111111"
	},
	"oauth_config": {
		"redirect_urls": ["http://localhost:43187/oauth/slack/callback"],
		"scopes": {
			"user": [
				"channels:read",
				"channels:history",
				"groups:read",
				"groups:history",
				"im:read",
				"im:history",
				"mpim:read",
				"mpim:history",
				"users:read",
				"chat:write"
			]
		},
		"pkce_enabled": true
	},
	"settings": {
		"org_deploy_enabled": false,
		"socket_mode_enabled": false,
		"token_rotation_enabled": true
	}
}
