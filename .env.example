# Local app configuration. Copy to .env; never commit real credentials.
# Muse conversation, reasoning, transcription and image generation share this key.
MODEL_API_KEY=
# Background coding: meta-api or muse-code (uses the signed-in vendor CLI account).
CODING_PROVIDER=meta-api
# Optional absolute Muse Code launcher path; blank detects the installed CLI.
MUSE_CODE_PATH=

# Optional shared team backend. Never put a Supabase service-role/admin key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
MUSE_TEAM_SERVICE_URL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional: Connect GitHub can import your existing gh login into this file.
GITHUB_TOKEN=
# Optional: own Linear tickets and user-selected teams/projects.
LINEAR_API_KEY=

# Browser login application credentials (tokens are stored privately by the app).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
LINEAR_OAUTH_CLIENT_ID=
# Optional when using Linear PKCE.
LINEAR_OAUTH_CLIENT_SECRET=

# Slack desktop browser login. Enable PKCE and register
# http://localhost:43187/oauth/slack/callback in the Slack app.
SLACK_OAUTH_CLIENT_ID=
# Only for a private internal customer-built Slack app; leave blank for commercial distribution.
SLACK_INTERNAL_APP=
# Optional local developer connection: a USER token and its app ID.
SLACK_USER_TOKEN=
SLACK_APP_ID=
# Optional Socket Mode app token; grants no user/channel access by itself.
SLACK_APP_TOKEN=
