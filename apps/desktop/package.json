{
	"name": "@metahackathon/desktop",
	"productName": "MetaHackathon",
	"version": "0.1.0",
	"description": "MetaHackathon desktop application",
	"main": "./out/main/index.js",
	"type": "module",
	"private": true,
	"scripts": {
		"postinstall": "electron-rebuild -f -w better-sqlite3 --module-dir ../..",
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"dist": "electron-vite build && electron-builder --mac --publish never",
		"pack": "electron-vite build && electron-builder --mac --dir --publish never",
		"preview": "electron-vite preview",
		"type-check": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.renderer.json",
		"db:generate": "drizzle-kit generate"
	},
	"dependencies": {
		"@tanstack/react-query": "5.95.2",
		"@tanstack/react-router": "1.168.8",
		"@trpc/client": "11.16.0",
		"@trpc/react-query": "11.16.0",
		"@trpc/server": "11.16.0",
		"better-sqlite3": "12.8.0",
		"drizzle-orm": "0.45.2",
		"electron-updater": "6.8.11",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"superjson": "2.2.6",
		"zod": "4.3.6",
		"zustand": "5.0.12"
	},
	"devDependencies": {
		"@electron/rebuild": "4.0.3",
		"@tailwindcss/postcss": "4.2.2",
		"@types/better-sqlite3": "7.6.13",
		"@types/node": "22.19.15",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "4.7.0",
		"autoprefixer": "10.4.27",
		"drizzle-kit": "0.30.6",
		"electron": "40.8.5",
		"electron-builder": "26.8.1",
		"electron-vite": "4.0.1",
		"postcss": "8.5.8",
		"tailwindcss": "4.2.2",
		"typescript": "5.9.3",
		"vite": "6.4.1",
		"@metahackathon/typescript-config": "workspace:*"
	}
}
