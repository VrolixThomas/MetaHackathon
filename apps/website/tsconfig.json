{
	"extends": "@metahackathon/typescript-config/react.json",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": { "@/*": ["./src/*"] },
		"plugins": [{ "name": "next" }],
		"allowJs": true,
		"noEmit": true,
		"incremental": true,
		"jsx": "preserve",
		"types": ["node", "react", "react-dom"]
	},
	"include": [
		"next-env.d.ts",
		"next.config.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		".next/types/**/*.ts"
	],
	"exclude": ["node_modules", ".next", "out"]
}
